# Android init service definition for the Nomad agent.
#
# Install on a device with a writable /system (root or custom ROM):
#
# adb root
# adb remount
# adb push nomad.rc /system/etc/init/nomad.rc
# adb push nomad /system/bin/nomad && adb shell chmod 755 /system/bin/nomad
# adb shell mkdir -p /data/local/nomad && adb push android.hcl /data/local/nomad/android.hcl
# adb reboot
#
# Verify with: adb shell 'getprop | grep nomad' and `logcat -s nomad`.
#
# Notes:
# - /system/bin/nomad is used because Android refuses to exec binaries from
# app-private storage under /data on API29+. init on older releases would
# allow /data/local/tmp, but /system/bin is the portable choice.
# - The service runs as root because raw_exec launches arbitrary binaries and
# because the agent mounts tmpfs for task secrets.
# - `oneshot` is deliberately NOT set: with a normal service init restarts the
# agent if it dies, which is what you want for a supervisor.

# Create the state directories before anything starts. init evaluates these in
# file order, so this block is placed ahead of the service and the trigger.
on init
 mkdir /data/local/nomad 777 root root
 mkdir /data/local/services 777 root root

service nomad /system/bin/nomad agent -config=/data/local/nomad/android.hcl
 class late_start
 user root
 group root system

 # A service under /system/etc/init must name its SELinux domain explicitly;
 # without this init logs "service nomad does not have a SELinux domain
 # defined" and never starts it. su is the only permissive domain available on
 # a userdebug build. raw_exec launches arbitrary binaries, so a locked-down
 # device needs a purpose-built domain and sepolicy instead.
 seclabel u:r:su:s0

 # Not oneshot: a normal service is restarted by init when it exits, which is
 # what a supervisor should do. init applies its own backoff.

# late_start services only run once the rest of the system is up, so wait for
# boot to complete rather than racing it.
on property:sys.boot_completed=1
 start nomad